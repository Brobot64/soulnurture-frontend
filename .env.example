# Copy to `.env` and adjust for your environment.
# Vite only exposes variables prefixed with VITE_ to the client.

# Origin of the Natlas backend (no trailing slash, no /api suffix —
# the app appends /api/v1/... itself). Local dev:
VITE_API_BASE_URL=http://localhost:3000
# Deployed API example — MUST be the backend's public https origin (Vercel
# serves the browser app, so localhost would point at the visitor's own
# machine). Set it per environment in the Vercel dashboard
# (Project → Settings → Environment Variables), e.g.:
# VITE_API_BASE_URL=https://api.your-domain.com

# WhatsApp number for the "talk to a person" handoff (digits only, country code first).
# Optional — defaults to the project number baked into the app.
# VITE_WHATSAPP_NUMBER=2348130388321
